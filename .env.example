# AllRatesToday - free key (no card): https://allratestoday.com/signup/
# Leave empty to use the keyless evaluation endpoint (latest table only, pair computed locally).
ALLRATESTODAY_API_KEY=

# QuickBooks Online - OAuth 2.0 access token + company (realm) id.
# How to get them: https://developer.intuit.com/app/developer/qbo/docs/develop/authentication-and-authorization/oauth-2.0
# Quick test tokens: https://developer.intuit.com/app/developer/playground
# Sandbox companies: https://developer.intuit.com/app/developer/qbo/docs/develop/sandboxes/manage-your-sandboxes
QBO_ACCESS_TOKEN=
QBO_REALM_ID=
# 1 = https://sandbox-quickbooks.api.intuit.com, empty = https://quickbooks.api.intuit.com
QBO_SANDBOX=1

# Xero - OAuth 2.0 access token + tenant id (only needed to read the organisation's enabled currencies).
# https://developer.xero.com/documentation/guides/oauth2/auth-flow/
# https://developer.xero.com/documentation/guides/oauth2/tenants/
XERO_ACCESS_TOKEN=
XERO_TENANT_ID=
